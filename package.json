  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/semver": "^7.8.0",
    "@yarnpkg/lockfile": "^1.1.0",
    "@yarnpkg/parsers": "^3.1.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "24.19.0",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22"
